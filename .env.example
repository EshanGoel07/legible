# Copy to .env (never commit .env). Sandbox only.

# --- LLM (any OpenAI-compatible provider; used by scanner + crashtest via src/llm.ts) ---
# Gemini (free tier):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash
# Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- PayPal Sandbox (one shared app; secrets shared privately, not in git) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Each person uses their OWN sandbox buyer for Crash Test runs
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Enables POST /safepay/test/approve/:checkoutId (Crash Test only). Never set in a deployed demo.
SAFEPAY_TEST_MODE=1

# --- Service URLs (swap fixture → real by changing these, never code) ---
STORE_URL=http://localhost:3001
PUBLISHER_URL=http://localhost:3002
SAFEPAY_URL=http://localhost:3003
DASHBOARD_URL=http://localhost:3004

# --- Paths ---
MANIFEST_PATH=fixtures/manifest.demo-store.json
RUNS_DIR=runs
