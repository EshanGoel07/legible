{
  "name": "legible",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:fixtures": "pnpm -r --parallel --if-present run dev:fixture",
    "dev": "pnpm -r --parallel --if-present run dev",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0",
    "@legible/contracts": "workspace:*"
  }
}
